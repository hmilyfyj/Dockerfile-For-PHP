FROM registry.cn-hangzhou.aliyuncs.com/shanjing/php-fpm@sha256:7a1d272ccf8dc2686d76994d335b97c0eed82815b5c88d7c3fbf8a7e1c786d6d

MAINTAINER fengit@outlook.com

# Alpine 3.23's default repository still ships nginx 1.28.3; use the signed stable package.
ADD --checksum=sha256:ff7cf138acc09f2a5029300ab713fe6a1440605fca72e2bab76a4da9206fec87 \
    https://nginx.org/keys/nginx_signing.rsa.pub /etc/apk/keys/nginx_signing.rsa.pub
ADD --checksum=sha256:d3e022393d1f9d5a1155e460565f96d8bdcf3401e8675f49940951c9b9b4599d \
    https://nginx.org/packages/alpine/v3.23/main/x86_64/nginx-1.30.6-r1.apk /tmp/nginx.apk
RUN apk add --no-network /tmp/nginx.apk \
    && rm -f /tmp/nginx.apk /etc/nginx/conf.d/default.conf /etc/nginx/sites-available/default
COPY nginx/enable-php.conf /etc/nginx/enable-php.conf
COPY nginx/site.conf /etc/nginx/conf.d/site.conf
COPY nginx/alpine-nginx.conf /etc/nginx/nginx.conf
#nginx end

COPY entrypoint.sh /etc/entrypoint.sh
RUN chmod +x /etc/entrypoint.sh
ENTRYPOINT ["/etc/entrypoint.sh"]

COPY html /var/www/html

RUN mkdir -p /var/log/php \
    && chown -R www-data:www-data /var/log/php
RUN sed -i 's/# server_tokens off/server_tokens off/g' /etc/nginx/nginx.conf
# RUN touch /etc/nginx/sites-available/default

STOPSIGNAL SIGQUIT
EXPOSE 80
CMD ["php-fpm", "-F"]

