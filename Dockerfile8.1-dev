FROM registry.cn-hangzhou.aliyuncs.com/shanjing/php-fpm:8.1

RUN rm $PHP_INI_DIR/conf.d/docker-php-ext-opcache-config.ini

COPY php.ini-unsecure /usr/local/etc/php/php.ini

